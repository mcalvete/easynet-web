[Unit]
Description=Easynet Web SQLite backup
After=easynet-web.service

[Service]
Type=oneshot
User=easynet
Group=easynet
EnvironmentFile=/etc/easynet-web.env
ExecStart=/usr/local/libexec/easynet-backup
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/easynet-web

